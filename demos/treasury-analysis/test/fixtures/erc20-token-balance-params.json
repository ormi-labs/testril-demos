{
  "additionalProperties": false,
  "properties": {
    "base_token_owners": {
      "default": [],
      "description": "Contracts answering `baseToken()`, each read as an owner of the token it answers",
      "items": {
        "pattern": "^0x[0-9a-fA-F]{40}$",
        "type": "string"
      },
      "type": "array"
    },
    "blacklist": {
      "default": [],
      "description": "Tokens never read",
      "items": {
        "pattern": "^0x[0-9a-fA-F]{40}$",
        "type": "string"
      },
      "type": "array"
    },
    "by": {
      "description": "Read once per period, at its last block, instead of at every block",
      "enum": ["hour", "day", "month", null],
      "period": true,
      "type": ["string", "null"]
    },
    "reads": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "owners": {
              "description": "The wallets whose balances are summed per token",
              "items": {
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "tokens": {
              "description": "The ERC-20 tokens to read, each at every owner",
              "items": {
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": ["tokens", "owners"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "pairs": {
              "description": "The (token, owner) pairs to read, each token summed over the owners it is paired with; an Aave v3 reserve's liquidity is (underlying, aToken)",
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "pattern": "^0x[0-9a-fA-F]{40}$",
                    "type": "string"
                  },
                  {
                    "pattern": "^0x[0-9a-fA-F]{40}$",
                    "type": "string"
                  }
                ],
                "type": "array"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": ["pairs"],
          "type": "object"
        }
      ],
      "description": "The balances to read: every token at every owner, or named (token, owner) pairs"
    }
  },
  "required": ["reads"],
  "type": "object"
}
