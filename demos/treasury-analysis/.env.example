# Mock mode needs only PORT. Live signing stays in this local file.
PORT=4173

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
TESTRIL_MCP_URL=https://dev.testril.ai/mcp
# Keep zero until you approve spending. This demo permits at most 0.1 each.
TESTRIL_CHARGE_CAP_USDC=0
TESTRIL_ESCROW_CAP_USDC=0

# Dedicated Base Sepolia test wallets; never put keys in browser code.
TREASURY_PRIVATE_KEY=
COUNTERPARTY_A_PRIVATE_KEY=
COUNTERPARTY_B_PRIVATE_KEY=
TESTRIL_PAYER_PRIVATE_KEY=

# Public addresses default to fixtures/live.json. Override when using your wallets.
# TREASURY_ADDRESS=0x...
# COUNTERPARTY_A_ADDRESS=0x...
# COUNTERPARTY_B_ADDRESS=0x...
# TESTRIL_PAYER_ADDRESS=0x...
